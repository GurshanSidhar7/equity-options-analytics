# Optional: copy to frontend/.env.local to override the default backend address.
# Used by the Next.js server; not exposed as a browser environment variable.
API_BASE_URL=http://127.0.0.1:8000

# On Vercel, vercel.json injects this through the frontend-to-backend binding.
# Do not set API_BASE_URL to localhost in the Vercel dashboard.

# Yahoo Finance ticker news currently requires no API key.
